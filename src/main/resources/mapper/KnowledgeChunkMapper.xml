<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartdesk.knowledge.KnowledgeChunkMapper">

    <resultMap id="chunkResultMap" type="com.smartdesk.knowledge.KnowledgeChunkEntity">
        <id property="id" column="id"/>
        <result property="documentId" column="document_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="chunkIndex" column="chunk_index"/>
        <result property="content" column="content"/>
        <result property="embeddingJson" column="embedding_json"/>
        <result property="tokenCount" column="token_count"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO knowledge_chunk (
            document_id, tenant_id, chunk_index, content,
            embedding_json, token_count, created_at
        )
        VALUES
        <foreach collection="chunks" item="chunk" separator=",">
            (
                #{chunk.documentId},
                #{chunk.tenantId},
                #{chunk.chunkIndex},
                #{chunk.content},
                #{chunk.embeddingJson},
                #{chunk.tokenCount},
                #{chunk.createdAt}
            )
        </foreach>
    </insert>

    <select id="countByDocumentId" resultType="int">
        SELECT COUNT(*) FROM knowledge_chunk WHERE document_id = #{documentId}
    </select>

    <select id="findAllByTenantId" resultMap="chunkResultMap">
        SELECT
            id, document_id, tenant_id, chunk_index, content,
            embedding_json, token_count, created_at
        FROM knowledge_chunk
        WHERE tenant_id = #{tenantId}
        ORDER BY document_id, chunk_index
    </select>

</mapper>