<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartdesk.auth.UserMapper">

    <resultMap id="userResultMap" type="com.smartdesk.auth.UserEntity">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="username" column="username"/>
        <result property="displayName" column="display_name"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="status" column="status"/>
        <result property="role" column="role"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="userColumns">
        id, tenant_id, username, display_name, password_hash, status, role,
        last_login_at, created_at, updated_at
    </sql>

    <insert id="insert"
            parameterType="com.smartdesk.auth.UserEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO app_user (
            tenant_id,
            username,
            display_name,
            password_hash,
            status,
            role,
            last_login_at,
            created_at,
            updated_at
        )
        VALUES (
            #{tenantId},
            #{username},
            #{displayName},
            #{passwordHash},
            #{status},
            #{role},
            #{lastLoginAt},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="findById" resultMap="userResultMap">
        SELECT
        <include refid="userColumns"/>
        FROM app_user
        WHERE id = #{id}
    </select>

    <select id="findByTenantIdAndUsername" resultMap="userResultMap">
        SELECT
        <include refid="userColumns"/>
        FROM app_user
        WHERE tenant_id = #{tenantId}
          AND username = #{username}
    </select>

    <select id="countByTenantId" resultType="int">
        SELECT COUNT(*)
        FROM app_user
        WHERE tenant_id = #{tenantId}
    </select>

    <select id="countByTenantIdAndUsername" resultType="int">
        SELECT COUNT(*)
        FROM app_user
        WHERE tenant_id = #{tenantId}
          AND username = #{username}
    </select>

    <update id="updateLastLogin">
        UPDATE app_user
        SET last_login_at = #{lastLoginAt},
            updated_at = #{lastLoginAt}
        WHERE id = #{id}
    </update>

</mapper>