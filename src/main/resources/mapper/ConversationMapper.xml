<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartdesk.conversation.ConversationMapper">

    <resultMap id="conversationResultMap" type="com.smartdesk.conversation.ConversationEntity">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="conversationColumns">
        id, tenant_id, user_id, title, status, created_at, updated_at
    </sql>

    <insert id="insert"
            parameterType="com.smartdesk.conversation.ConversationEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO conversation (
            tenant_id,
            user_id,
            title,
            status,
            created_at,
            updated_at
        )
        VALUES (
            #{tenantId},
            #{userId},
            #{title},
            #{status},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="findById" resultMap="conversationResultMap">
        SELECT
        <include refid="conversationColumns"/>
        FROM conversation
        WHERE id = #{id}
    </select>

    <select id="findAllByTenantIdAndUserId" resultMap="conversationResultMap">
        SELECT
        <include refid="conversationColumns"/>
        FROM conversation
        WHERE tenant_id = #{tenantId}
          AND user_id = #{userId}
        ORDER BY updated_at DESC, id DESC
    </select>

    <update id="touchUpdatedAt">
        UPDATE conversation
        SET updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

</mapper>