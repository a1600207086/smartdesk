<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartdesk.tenant.TenantMapper">

    <resultMap id="tenantResultMap" type="com.smartdesk.tenant.TenantEntity">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="tenantColumns">
        id, code, name, status, created_at, updated_at
    </sql>

    <insert id="insert"
            parameterType="com.smartdesk.tenant.TenantEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO tenant (code, name, status, created_at, updated_at)
        VALUES (#{code}, #{name}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findById" resultMap="tenantResultMap">
        SELECT
        <include refid="tenantColumns"/>
        FROM tenant
        WHERE id = #{id}
    </select>

    <select id="findByCode" resultMap="tenantResultMap">
        SELECT
        <include refid="tenantColumns"/>
        FROM tenant
        WHERE code = #{code}
    </select>

    <select id="findAll" resultMap="tenantResultMap">
        SELECT
        <include refid="tenantColumns"/>
        FROM tenant
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM tenant
    </select>

    <select id="countByCode" resultType="int">
        SELECT COUNT(*)
        FROM tenant
        WHERE code = #{code}
    </select>

</mapper>